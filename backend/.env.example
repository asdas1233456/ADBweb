# 数据库配置
DATABASE_URL=sqlite:///./test_platform.db

# 服务器配置
HOST=0.0.0.0
PORT=8000

# 文件上传配置
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# 日志配置
LOG_LEVEL=INFO

# AI API配置
AI_API_KEY=
AI_API_BASE=https://api.deepseek.com/v1
ALLOWED_AI_API_HOSTS=api.deepseek.com,api.openai.com

# 安全与访问控制
API_AUTH_ENABLED=true
API_ACCESS_KEY=CHANGE_ME
ENABLE_UPLOADS_STATIC=false
ENABLE_SCRIPT_EXECUTION=true
ENABLE_AUTO_PIP_INSTALL=false
ALLOWED_SCRIPT_EXTS=.py,.bat
ALLOWED_IMAGE_EXTS=.png,.jpg,.jpeg
